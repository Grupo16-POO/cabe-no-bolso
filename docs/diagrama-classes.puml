@startuml
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "br.com.cabenobolso.model" {
    class Planejamento {
        - {static} serialVersionUID : long = 1L
        - participantes : Map<Integer, Participante>
        - despesas : List<Despesa>
        + Planejamento()
        + adicionarParticipante(participante : Participante) : void
        + atualizarParticipante(codigo : int, novoNome : String, novoOrcamento : BigDecimal) : void
        + removerParticipante(codigo : int) : void
        + buscarParticipantePorCodigo(codigo : int) : Participante
        + getParticipantesOrdenados() : List<Participante>
        + adicionarDespesa(despesa : Despesa) : void
        + substituirDespesa(indice : int, novaDespesa : Despesa) : void
        + removerDespesa(indice : int) : void
        + removerDespesa(despesa : Despesa) : void
        + getDespesas() : List<Despesa>
        + calcularTotaisIndividuais() : Map<Participante, BigDecimal>
        + calcularCustoTotalGeral() : BigDecimal
        + calcularExcedentes() : Map<Participante, BigDecimal>
    }

    class Participante {
        - {static} serialVersionUID : long = 1L
        - codigo : int
        - nome : String
        - orcamento : BigDecimal
        + Participante(codigo : int, nome : String, orcamento : BigDecimal)
        + atualizarDados(novoNome : String, novoOrcamento : BigDecimal) : void
        + getCodigo() : int
        + getNome() : String
        + setNome(nome : String) : void
        + getOrcamento() : BigDecimal
        + setOrcamento(orcamento : BigDecimal) : void
        + compareTo(outro : Participante) : int
    }

    abstract class Despesa {
        - {static} serialVersionUID : long = 1L
        - descricao : String
        - valor : BigDecimal
        - participantes : Set<Participante>
        - essencial : boolean
        - prioridade : int
        + Despesa(descricao : String, valor : BigDecimal, participantes : Collection<Participante>, essencial : boolean, prioridade : int)
        + atualizarDados(novaDescricao : String, novoValor : BigDecimal, novosParticipantes : Collection<Participante>, essencial : boolean, prioridade : int) : void
        + {abstract} calcularRateio() : Map<Participante, BigDecimal>
        + {abstract} getCustoTotal() : BigDecimal
        + {abstract} getTipoDescricao() : String
        + getDescricao() : String
        + getValor() : BigDecimal
        + getParticipantes() : Set<Participante>
        + isEssencial() : boolean
        + getPrioridade() : int
    }

    class DespesaFixa {
        - {static} serialVersionUID : long = 1L
        + calcularRateio() : Map<Participante, BigDecimal>
        + getCustoTotal() : BigDecimal
        + getTipoDescricao() : String
    }

    class DespesaPorPessoa {
        - {static} serialVersionUID : long = 1L
        + calcularRateio() : Map<Participante, BigDecimal>
        + getCustoTotal() : BigDecimal
        + getTipoDescricao() : String
    }

    class OtimizadorDespesas {
        + {static} otimizar(planejamento : Planejamento) : ResultadoOtimizacao
    }

    class ResultadoOtimizacao {
        - viavel : boolean
        - despesasMantidas : List<Despesa>
        - despesasRetiradas : List<Despesa>
        - somaPrioridades : int
        - novosTotaisIndividuais : Map<Participante, BigDecimal>
        - novoCustoTotalGeral : BigDecimal
        - mensagem : String
        + isViavel() : boolean
        + getDespesasMantidas() : List<Despesa>
        + getDespesasRetiradas() : List<Despesa>
        + getSomaPrioridades() : int
        + getNovosTotaisIndividuais() : Map<Participante, BigDecimal>
        + getNovoCustoTotalGeral() : BigDecimal
        + getMensagem() : String
    }
}

package "br.com.cabenobolso.persistence" {
    interface PersistenciaService {
        + salvar(planejamento : Planejamento, caminhoArquivo : String) : void
        + carregar(caminhoArquivo : String) : Planejamento
    }

    class PersistenciaArquivo {
        + salvar(planejamento : Planejamento, caminhoArquivo : String) : void
        + carregar(caminhoArquivo : String) : Planejamento
    }
}

package "br.com.cabenobolso.controller" {
    class PlanejamentoController {
        - planejamento : Planejamento
        - persistenciaService : PersistenciaService
        + PlanejamentoController()
        + novoPlanejamento() : void
        + cadastrarParticipante(codigo : int, nome : String, orcamento : BigDecimal) : void
        + editarParticipante(codigo : int, novoNome : String, novoOrcamento : BigDecimal) : void
        + excluirParticipante(codigo : int) : void
        + listarParticipantes() : List<Participante>
        + cadastrarDespesa(tipo : String, descricao : String, valor : BigDecimal, codigosParticipantes : List<Integer>, essencial : boolean, prioridade : int) : void
        + editarDespesa(indice : int, tipo : String, descricao : String, valor : BigDecimal, codigosParticipantes : List<Integer>, essencial : boolean, prioridade : int) : void
        + excluirDespesa(indice : int) : void
        + listarDespesas() : List<Despesa>
        + calcularTotaisIndividuais() : Map<Participante, BigDecimal>
        + calcularExcedentes() : Map<Participante, BigDecimal>
        + calcularCustoTotalGeral() : BigDecimal
        + executarSimulador() : ResultadoOtimizacao
        + salvarPlanejamento(caminhoArquivo : String) : void
        + carregarPlanejamento(caminhoArquivo : String) : void
        + carregarCasoReferencia() : void
    }
}

package "br.com.cabenobolso.view" {
    class MainFrame {
        - controller : PlanejamentoController
        + MainFrame()
        + {static} main(args : String[]) : void
    }
}

Planejamento "1" *-- "0..*" Participante : gerencia >
Planejamento "1" *-- "0..*" Despesa : contém >
Despesa "0..*" o-- "1..*" Participante : rateada entre >
Despesa <|-- DespesaFixa
Despesa <|-- DespesaPorPessoa
PersistenciaService <|.. PersistenciaArquivo
PlanejamentoController "1" --> "1" Planejamento : coordena >
PlanejamentoController "1" --> "1" PersistenciaService : persiste via >
MainFrame "1" --> "1" PlanejamentoController : aciona >
OtimizadorDespesas ..> Planejamento : analisa >
OtimizadorDespesas +-- ResultadoOtimizacao
@enduml